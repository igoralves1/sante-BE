# Copie para .env e ajuste. Nunca suba o .env para o GitHub.
POSTGRES_USER=sante
POSTGRES_PASSWORD=sante
POSTGRES_DB=sante
DB_PORT=5432
API_PORT=8000
CORS_ORIGINS=https://igoralves1.github.io
SEED_ON_START=true
RELOAD=true
# páginas de consultas do front (/api/banco/*): sempre só leitura
BANCO_CONSULTAS=true
BANCO_TEMPO_MS=5000
# senha do papel sante_leitura; vazio = aleatória a cada início
BANCO_LEITURA_SENHA=
# chave da API da Anthropic (console.anthropic.com), para traduzir perguntas em português para SQL
ANTHROPIC_API_KEY=
# rodando a API fora do Docker:
DATABASE_URL=postgres://sante:sante@localhost:5432/sante
